# Environment Configuration
# Copy this file to .env in your root or backend folder

# Google Gemini API Key for AI Assistant (Phase 3)
# Obtain your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=place_holder_API_KEY
# Database URL (Optional: Leave empty to automatically use SQLite app.db)
# For production PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/bi_platform
DATABASE_URL=
